const GEONROK_BRANCH = {
  T: 2, // 갑 -> 인
  t: 3, // 을 -> 묘
  F: 5, // 병 -> 사
  f: 6, // 정 -> 오
  E: 5, // 무 -> 사
  e: 6, // 기 -> 오
  M: 8, // 경 -> 신
  m: 9, // 신 -> 유
  W: 11, // 임 -> 해
  w: 0  // 계 -> 자
}

function getStrengthLevel5(value) {
  if (value >= 60) return { level: "Very Strong", koreanLevel: "극신강" }
  if (value >= 40) return { level: "Strong", koreanLevel: "신강" }
  if (value >= 30) return { level: "Balanced", koreanLevel: "중화" }
  if (value >= 20) return { level: "Weak", koreanLevel: "신약" }
  return { level: "Very Weak", koreanLevel: "극신약" }
}

function addSupport(score, element, amount, dayEnergy, motherEnergy, detail, label) {
  if (element === dayEnergy) {
    score.value += amount
    detail.push(`${label}: direct root +${Number(amount.toFixed(2))}`)
  }

  if (element === motherEnergy) {
    const v = amount * 0.7
    score.value += v
    detail.push(`${label}: generating support +${Number(v.toFixed(2))}`)
  }
}

function branchHasDayStem(branchIndex, dayStemSymbol) {
  return (HIDDEN_SKY_ENERGY[branchIndex] || []).includes(dayStemSymbol)
}

function countTonggeun(pillars, dayStemSymbol) {
  let count = 0
  for (const key of ["year", "month", "day", "hour"]) {
    if (branchHasDayStem(pillars[key].branch.index, dayStemSymbol)) count++
  }
  return count
}

function calculateTonggeunBonus(count) {
  if (count >= 3) return 8
  if (count === 2) return 5
  if (count === 1) return 3
  return 0
}

function countHeavenlyPeerSupport(pillars, dayEnergy, dayStemSymbol) {
  let count = 0
  for (const key of ["year", "month", "hour"]) {
    const stem = pillars[key].stem
    if (stem.element === dayEnergy) count++
  }
  return Math.min(6, count * 3)
}

function climateUsefulEnergyByMonth(monthBranchIndex, dayEnergy) {
  // 조후용신 v1
  if ([11, 0, 1].includes(monthBranchIndex)) return "Fire"   // winter
  if ([5, 6, 7].includes(monthBranchIndex)) return "Water"   // summer
  if ([2, 3, 4].includes(monthBranchIndex)) return "Metal"   // spring
  if ([8, 9, 10].includes(monthBranchIndex)) return "Fire"   // autumn
  return controllingElementOf(dayEnergy)
}

function calculateDayStrength(pillars) {
  const dayStemSymbol = pillars.day.stem.symbol
  const dayEnergy = pillars.day.stem.element
  const motherEnergy = motherElementOf(dayEnergy)
  const monthBranch = pillars.month.branch
  const detail = []
  const score = { value: 0 }

  // 1. Month branch + month hidden stems = 35%
  {
    const weight = PILLAR_WEIGHTS.month
    addSupport(score, monthBranch.element, weight * 0.7, dayEnergy, motherEnergy, detail, "month branch")

    const hse = HIDDEN_SKY_ENERGY[monthBranch.index] || []
    const each = hse.length ? (weight * 0.3) / hse.length : 0
    for (const stemSymbol of hse) {
      addSupport(score, elementOfStemSymbol(stemSymbol), each, dayEnergy, motherEnergy, detail, "month hidden stem")
    }
  }

  // 2. Day 20%, Hour 30%, Year 15%
  // stem 40%, branch 40%, hidden stems 20%
  for (const key of ["day", "hour", "year"]) {
    const p = pillars[key]
    const weight = PILLAR_WEIGHTS[key]

    addSupport(score, p.stem.element, weight * 0.4, dayEnergy, motherEnergy, detail, `${key} stem`)
    addSupport(score, p.branch.element, weight * 0.4, dayEnergy, motherEnergy, detail, `${key} branch`)

    const hse = HIDDEN_SKY_ENERGY[p.branch.index] || []
    const each = hse.length ? (weight * 0.2) / hse.length : 0
    for (const stemSymbol of hse) {
      addSupport(score, elementOfStemSymbol(stemSymbol), each, dayEnergy, motherEnergy, detail, `${key} hidden stem`)
    }
  }

  const bonus = {
    dayHiddenStem: 0,
    monthHiddenStem: 0,
    geonrok: 0,
    tonggeun: 0,
    heavenlyPeer: 0,
    deukryeong: 0
  }

  // 일지 투간 +10
  if (branchHasDayStem(pillars.day.branch.index, dayStemSymbol)) {
    bonus.dayHiddenStem = 10
    detail.push("bonus: day branch contains Day Stem +10")
  }

  // 월지 지장간에 일간 포함 +10
  if (branchHasDayStem(pillars.month.branch.index, dayStemSymbol)) {
    bonus.monthHiddenStem = 10
    detail.push("bonus: month branch hidden stem contains Day Stem +10")
  }

  // 건록 +10
  if (GEONROK_BRANCH[dayStemSymbol] === pillars.month.branch.index) {
    bonus.geonrok = 10
    detail.push("bonus: Geonrok in month branch +10")
  }

  // 득령 +15: 월지 오행이 일간 오행과 같을 때
  if (pillars.month.branch.element === dayEnergy) {
    bonus.deukryeong = 15
    detail.push("bonus: seasonal command acquired +15")
  }

  // 통근 +3/+5/+8
  const tonggeunCount = countTonggeun(pillars, dayStemSymbol)
  bonus.tonggeun = calculateTonggeunBonus(tonggeunCount)
  if (bonus.tonggeun) {
    detail.push(`bonus: Tonggeun ${tonggeunCount} root(s) +${bonus.tonggeun}`)
  }

  // 천간 비견/겁재 +0~6
  bonus.heavenlyPeer = countHeavenlyPeerSupport(pillars, dayEnergy, dayStemSymbol)
  if (bonus.heavenlyPeer) {
    detail.push(`bonus: heavenly peer support +${bonus.heavenlyPeer}`)
  }

  const bonusTotal = Object.values(bonus).reduce((a, b) => a + b, 0)
  const value = Number((score.value + bonusTotal).toFixed(2))
  const lv = getStrengthLevel5(value)

  const climateMode = pillars.month.branch.element === dayEnergy

  return {
    value,
    score: value,
    level: lv.level,
    koreanLevel: lv.koreanLevel,
    dayEnergy,
    motherEnergy,
    dominantEnergy: dayEnergy,
    monthBranchEnergy: pillars.month.branch.element,
    climateMode,
    climateUsefulEnergy: climateMode ? climateUsefulEnergyByMonth(pillars.month.branch.index, dayEnergy) : null,
    pillarWeight: PILLAR_WEIGHTS,
    bonus,
    bonusTotal,
    tonggeunCount,
    method: "K-UPFATE Strength Engine v3",
    detail
  }
}

function childElementOf(element) {
  return GENERATES[element]
}

function wealthElementOf(element) {
  return GENERATES[childElementOf(element)]
}

function calculateUsefulEnergySet(strength) {
  const dayEnergy = strength.dayEnergy

  // 월지와 일간 오행이 같으면 조후용신 우선
  if (strength.climateMode && strength.climateUsefulEnergy) {
    return {
      usefulEnergy: strength.climateUsefulEnergy,
      supportingEnergy: childElementOf(strength.climateUsefulEnergy),
      usefulMethod: "Climate Useful Energy"
    }
  }

  // 신강/극신강: 식상 우선, 재성 희신
  if (strength.level === "Very Strong" || strength.level === "Strong") {
    const output = childElementOf(dayEnergy)
    const wealth = wealthElementOf(dayEnergy)

    return {
      usefulEnergy: output,
      supportingEnergy: wealth,
      usefulMethod: "Strong Day Master: Output first, Wealth second"
    }
  }

  // 신약/극신약: 인성 우선, 비겁 희신
  if (strength.level === "Weak" || strength.level === "Very Weak") {
    return {
      usefulEnergy: strength.motherEnergy,
      supportingEnergy: dayEnergy,
      usefulMethod: "Weak Day Master: Resource first, Peer second"
    }
  }

  // 중화: 흐름을 열어주는 식상 우선
  return {
    usefulEnergy: childElementOf(dayEnergy),
    supportingEnergy: wealthElementOf(dayEnergy),
    usefulMethod: "Balanced Day Master: Output and Wealth flow"
  }
}

function normalizeCResult(raw) {
  const pillars = raw.pillars

  const fiveEnergy = calculateFiveEnergy(pillars)
  const strength = calculateDayStrength(pillars)
  const usefulSet = calculateUsefulEnergySet(strength)

  return {
    ...raw,
    fiveEnergy,
    strength,
    usefulEnergy: usefulSet.usefulEnergy,
    supportingEnergy: usefulSet.supportingEnergy,
    usefulMethod: usefulSet.usefulMethod
  }
}

function runSajuEngine(year, month, day, hour, minute) {
  const cliPath = path.join(__dirname, "..", "cal20000", "saju-cli")

  const result = spawnSync(
    cliPath,
    [String(year), String(month), String(day), String(hour), String(minute)],
    {
      encoding: "utf-8"
    }
  )

  if (result.error) {
    throw new Error(`C engine failed: ${result.error.message}`)
  }

  if (result.status !== 0) {
    throw new Error(`C engine failed: ${result.stderr}`)
  }

  const raw = JSON.parse(result.stdout)
  return normalizeCResult(raw)
}

if (require.main === module) {
  const [year, month, day, hour, minute] = process.argv.slice(2).map(Number)
  const result = runSajuEngine(year, month, day, hour, minute)
  console.log(JSON.stringify(result))
}

module.exports = {
  runSajuEngine
}
